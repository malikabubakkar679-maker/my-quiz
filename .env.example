# Clerk (https://dashboard.clerk.com -> API Keys). Leave empty in development to use Clerk keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (Project Settings -> API). The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Clerk user IDs that are automatically promoted to admin.
ADMIN_CLERK_USER_IDS=
